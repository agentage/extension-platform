    "/api/v1/installations/{target}": {
      "get": {
        "summary": "Read an installation",
        "security": [
          {},
          {
            "pat": ["platform:read"]
          }
        ],
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(m_[0-9a-f]{8}|h_[0-9a-z-]{1,63})$"
